# Copy to .env for `docker compose up`, or set these in your host's dashboard.
#
# The browser calls the API directly, so this must be the API's PUBLIC url.
NEXT_PUBLIC_API_URL=http://localhost:5050

# Lock CORS to the front-end origin in production (comma-separated for several).
ALLOWED_ORIGINS=http://localhost:3000

# Max upload size (MB) and how long processed jobs are kept before cleanup (hours).
MAX_UPLOAD_MB=250
JOB_TTL_HOURS=24
